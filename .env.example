# CompreFace — face verification (optional, leave empty to skip)
COMPREFACE_URL=http://localhost:8000
COMPREFACE_API_KEY=

# MongoDB
MONGO_URI=mongodb://localhost:27017/tenali

# JWT
JWT_SECRET=your-secret-here

# Seed logins — comma-separated "username:password[:role]" entries.
# Add ":admin" to exactly one entry for proctor-dashboard access.
# Keep the real values only in the deployed .env, never here.
TENALI_SEED_USERS=user1:pass1,user2:pass2,admin:adminpass:admin

# Server
PORT=4000
